/*
 * Nextflow settings for gpcr-salt-bridges.
 *
 * The execution reports go in results/, which is regenerated output and not
 * committed. They overwrite on each run: the record that matters is the one
 * from the current state of the code.
 */

manifest {
    name            = 'gpcr-salt-bridges'
    author          = 'Jawaher Basalma'
    description     = 'Does the ionic lock break when a class A GPCR activates?'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
}

params {
    config = 'config/structures.yaml'
}

report {
    enabled   = true
    overwrite = true
    file      = 'results/nextflow/report.html'
}

timeline {
    enabled   = true
    overwrite = true
    file      = 'results/nextflow/timeline.html'
}

dag {
    enabled   = true
    overwrite = true
    file      = 'results/nextflow/dag.html'
}

trace {
    enabled   = true
    overwrite = true
    file      = 'results/nextflow/trace.txt'
    fields    = 'task_id,name,status,exit,duration,realtime,%cpu,peak_rss'
}

process {
    errorStrategy = 'terminate'
}
